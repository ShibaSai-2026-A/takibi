#pragma kernel Clear
#pragma kernel Advect
#pragma kernel BuildHeatProfile

Texture3D<float4> _Read;
SamplerState sampler_Read;
RWTexture3D<float4> _Write;
RWTexture2D<float4> _HeatProfileWrite;
int3 _Resolution;
float _Dt, _Energy, _Breath, _TimeValue, _Turbulence;
float4 _Sources[7];

static const float3 BoxMin=float3(-1.55,-0.15,-1.1);
static const float3 BoxSize=float3(3.1,3.6,2.2);

float Pulse(float seed,float t)
{
    float cell=floor(t), f=frac(t);
    f=f*f*f*(f*(f*6-15)+10);
    float a=frac(sin(cell*17.17+seed*91.3)*43758.5453);
    float b=frac(sin((cell+1)*17.17+seed*91.3)*43758.5453);
    return lerp(a,b,f);
}

float3 Curl(float3 p,float t)
{
    // ベクトルポテンシャルの解析的なcurl。全体を一斉に振るのではなく空間内で回転する。
    float a=cos(1.3*p.y+0.9*p.z+0.73*t)*cos(0.7*p.x-1.1*t);
    float b=cos(1.7*p.z+0.6*p.x-0.87*t);
    float c=cos(1.4*p.x+0.8*p.y+1.4*t)*cos(0.9*p.z);
    return float3(0.8*c-1.7*b,0.9*a-1.4*c,0.6*b-1.3*a);
}

[numthreads(8,8,4)]
void Clear(uint3 id:SV_DispatchThreadID) { _Write[id]=0; }

[numthreads(8,8,4)]
void Advect(uint3 id:SV_DispatchThreadID)
{
    float3 uv=(id+0.5)/float3(_Resolution);
    float3 p=BoxMin+uv*BoxSize;
    float temperature=_Read.SampleLevel(sampler_Read,uv,0).g;
    float3 curl=Curl(p*2.2+float3(3.1,7.4,1.7),_TimeValue*0.72)*0.55;
    curl+=Curl(p*5.1+float3(13.2,2.6,9.1),_TimeValue*1.13)*0.19;
    curl+=Curl(p*9.6+float3(1.7,23.4,11.2),_TimeValue*1.67)*0.10;
    float height=saturate((p.y-0.25)/2.2);
    float rootAnchor=smoothstep(0.25,0.56,p.y);
    float3 velocity=float3(-p.x*0.10,0.72+temperature*1.05,-p.z*0.10);
    velocity.xz+=curl.xz*(0.40+0.55*height)*rootAnchor*_Turbulence;
    velocity.y+=curl.y*0.20*rootAnchor*_Turbulence;
    velocity.y+=_Breath*0.10*temperature;
    float3 previousUV=uv-velocity*_Dt/BoxSize;
    float4 state=0;
    if(all(previousUV>0) && all(previousUV<1)) state=_Read.SampleLevel(sampler_Read,previousUV,0);
    // 温度が下がると先端から発光が消える。炎の高さやTransformを伸縮しない。
    state.r*=exp(-_Dt*0.42);
    state.g*=exp(-_Dt*(1.12+0.28*(1-_Energy)));

    float sourceDensity=0, sourceHeat=0;
    [unroll] for(int j=0;j<7;j++)
    {
        float4 source=_Sources[j];
        float activation=j==0?smoothstep(0.005,0.12,_Energy):smoothstep(0.10+j*0.035,0.40+j*0.055,_Energy);
        float3 d=(p-source.xyz)/float3(0.215,0.080,0.165);
        float footprint=exp(-dot(d,d)*1.8);
        float pulse=Pulse(j+1.3,_TimeValue*(1.65+j*0.073));
        float emitted=footprint*activation*(0.48+0.72*pulse);
        sourceDensity+=emitted*(0.08+_Energy*0.92);
        sourceHeat+=emitted*(0.12+_Energy*1.20)*lerp(0.76,1.05,source.w);
    }
    state.r+=sourceDensity*_Dt*12;
    state.g+=sourceHeat*_Dt*16;
    // 端の1〜2セルは吸収境界。上端で炎が切れて見えるのを抑える。
    float edge=min(min(uv.x,1-uv.x),min(uv.z,1-uv.z));
    float boundary=smoothstep(0,0.035,edge)*(1-smoothstep(0.94,1,uv.y));
    state.rg*=boundary;
    _Write[id]=float4(clamp(state.rg,0,1.8),0,0);
}

groupshared float HeatPeak[64];
[numthreads(64,1,1)]
void BuildHeatProfile(uint3 group:SV_GroupID,uint lane:SV_GroupIndex)
{
    // 熱が到達した高さをGPUで抽出する。見た目の輪郭とは分離する。
    float peak=0;
    for(int z=0;z<_Resolution.z;z++) peak=max(peak,_Read.Load(int4(lane,group.y,z,0)).g);
    HeatPeak[lane]=peak;
    GroupMemoryBarrierWithGroupSync();
    for(uint stride=32;stride>0;stride>>=1)
    {
        if(lane<stride) HeatPeak[lane]=max(HeatPeak[lane],HeatPeak[lane+stride]);
        GroupMemoryBarrierWithGroupSync();
    }
    if(lane==0) _HeatProfileWrite[int2(group.y,0)]=float4(HeatPeak[0],0,0,0);
}
